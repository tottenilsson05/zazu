# ─────────────────────────────────────────────────────────────
# ZAZU site configuration
# Copy to .env.local for local dev, or add these in
# Vercel → Project → Settings → Environment Variables.
# None of them are required: sensible defaults are built in.
# ─────────────────────────────────────────────────────────────

# Official X (Twitter) account. Until this is set, every X button opens
# a live X search for $ZAZU so no link is broken.
NEXT_PUBLIC_X_URL=https://x.com/zazucatPF

# Public URL of the deployed site (used for social preview images)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Token contract (defaults to the $ZAZU pump.fun address)
NEXT_PUBLIC_ZAZU_CA=2KVUyPJra7KD1ayYFDZh3ZumzNPw9xGzwogHky9Upump

# Override the Pump.fun / Dexscreener links if they ever change
NEXT_PUBLIC_PUMP_URL=
NEXT_PUBLIC_DEX_URL=

# Token panel refresh interval in milliseconds (default 10000)
NEXT_PUBLIC_TOKEN_REFRESH_MS=10000

# Server-side only: DEX Screener API base (no key needed)
DEXSCREENER_API_BASE=https://api.dexscreener.com
